#!/bin/sh

set -eu

check_only=false
if [ "${1:-}" = "--check" ]; then
    check_only=true
    shift
fi

if [ "$#" -ne 1 ]; then
    printf '%s\n' 'Usage: rig-fleet-onboard [--check] <worker-slug>' >&2
    exit 2
fi

member=$1
case "$member" in
    *[!a-z0-9-]*|'')
        printf '%s\n' 'Worker slug must use lowercase letters, digits, and hyphens.' >&2
        exit 2
        ;;
esac

software_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
rig_root=$(CDPATH= cd -- "${RIG_INSTANCE_ROOT:-$software_root}" && pwd)
project_root=$rig_root
if [ -f "$rig_root/rig.toml" ]; then
    configured_project=$(sed -n 's/^project_root[[:space:]]*=[[:space:]]*"\([^"]*\)"[[:space:]]*$/\1/p' "$rig_root/rig.toml")
    if [ -n "$configured_project" ]; then
        case "$configured_project" in
            /*) project_root=$configured_project ;;
            *) project_root="$rig_root/$configured_project" ;;
        esac
    fi
fi
project_root=$(CDPATH= cd -- "$project_root" && pwd)
member_home="$rig_root/fleet/$member"
member_config="$member_home/member.toml"

if [ ! -f "$member_config" ]; then
    printf 'No worker configuration: %s\n' "$member_config" >&2
    exit 1
fi

config_value() {
    sed -n "s/^[[:space:]]*$1[[:space:]]*=[[:space:]]*\"\([^\"]*\)\"[[:space:]]*$/\1/p" "$member_config" | sed -n '1p'
}

worktree=$(config_value worktree)
branch=$(config_value branch)
integration_branch=$(config_value integration_branch)

case "$worktree" in
    ''|/*|*..*)
        printf 'Unsafe worktree value in %s: %s\n' "$member_config" "$worktree" >&2
        exit 1
        ;;
esac

if [ -z "$branch" ]; then
    printf 'Missing branch value in %s\n' "$member_config" >&2
    exit 1
fi

if [ -z "$integration_branch" ]; then
    printf 'Missing integration_branch value in %s\n' "$member_config" >&2
    exit 1
fi

if [ -e "$member_home/$worktree" ]; then
    printf 'Worktree path already exists: %s\n' "$member_home/$worktree" >&2
    exit 1
fi

if [ "$check_only" = true ]; then
    git -C "$project_root" rev-parse --verify "$integration_branch^{commit}" >/dev/null
    printf 'member=%s\nhome=%s\nproject=%s\nworktree=%s\nbranch=%s\nintegration_branch=%s\n' \
        "$member" "$member_home" "$project_root" "$member_home/$worktree" "$branch" "$integration_branch"
    exit 0
fi

exec git -C "$project_root" worktree add -b "$branch" \
    "$member_home/$worktree" "$integration_branch"
